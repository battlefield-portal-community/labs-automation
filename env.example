# Copy to .env and fill in. Every variable is validated at startup; the hub
# reports all problems at once rather than dying on the first one.

# --- what runs ---------------------------------------------------------------
# Comma-separated automation names from src/automations/index.ts
AUTOMATIONS=auto-join

# --- Kaneo -------------------------------------------------------------------
# The bundled Kaneo image serves the API under /api on 5173.
# If the API runs as its own service, use http://api:1337 instead.
KANEO_API_URL=http://kaneo:5173/api

# Workspace every new account joins. Find it with:
#   docker compose exec postgres psql -U kaneo -d kaneo -c 'SELECT id, name FROM workspace;'
KANEO_WORKSPACE_ID=

# Role to grant: viewer | member | admin, or a workspace custom role.
KANEO_WORKSPACE_ROLE=member

# Device-flow session token. Prefer the file (mounted read-only); the inline
# variable wins when both are set.
#   docker run --rm -it -v "$PWD/secrets:/secrets" \
#     -e KANEO_API_URL=https://yourdomain.com/api \
#     kaneo-labs-automation:0.1.0 node src/cli/device-auth.ts /secrets/kaneo_admin_token
KANEO_ADMIN_TOKEN_FILE=/run/secrets/kaneo_admin_token
#KANEO_ADMIN_TOKEN=

# --- database ----------------------------------------------------------------
# Same role the API uses; only LISTEN (and `migrate`) needs it.
DATABASE_URL=postgres://kaneo:change-me@postgres:5432/kaneo

# --- behaviour ---------------------------------------------------------------
# Safety net for notifications lost while the sidecar was down. Keep well under
# the session lifetime (7 days) - this loop is also what keeps the token alive.
RECONCILE_INTERVAL_MIN=10

# Leave instance administrators out of the auto-join (custom admin roles cannot
# be detected, only role = "admin").
SKIP_INSTANCE_ADMINS=false

# Apply sql/ at boot instead of running migrate as a separate step.
MIGRATE_ON_START=false

# --- observability -----------------------------------------------------------
LOG_LEVEL=info
HEALTH_PORT=8080
